PORT=3001

# Banco (dev: localhost; no Docker o host vira "db" automaticamente)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Importação inicial das contas (scripts/import-env-accounts.mjs); depois podem sair do .env
IG_AQUA_ID=
IG_AQUA_TOKEN=
IG_EZF_ID=
IG_EZF_TOKEN=
IG_PUKA_ID=
IG_PUKA_TOKEN=
IG_TABUA_ID=
IG_TABUA_TOKEN=

# Anúncios (Marketing API). Os tokens NÃO ficam aqui: cadastre com `npm run ads -- token <LABEL>`.
# Versão da Graph API (opcional; padrão v26.0)
META_GRAPH_VERSION=
# Chave secreta do app Metricas (opcional; obrigatória só se o app exigir "App Secret Proof")
META_APP_SECRET=

# Webhook / Meta / Gemini
VERIFY_TOKEN=
META_ACCESS_TOKEN=
GEMINI_API_KEY=
