generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IgAccount {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alias            String   @unique
  igUserId         String   @unique @map("ig_user_id")
  username         String
  accessTokenEnc   String   @map("access_token_enc")
  tokenExpiresAt   DateTime @map("token_expires_at") @db.Timestamptz(6)
  tokenRefreshedAt DateTime @map("token_refreshed_at") @db.Timestamptz(6)
  status           String   @default("active") // 'active' | 'needs_reauth'
  lastError        String?  @map("last_error")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ig_accounts")
}

// Cache dos insights por post (ver src/services/mediaInsights.js). null = indisponível.
model MediaInsight {
  alias             String
  mediaId           String   @map("media_id")
  postedAt          DateTime @map("posted_at") @db.Timestamptz(6)
  mediaType         String   @map("media_type")
  mediaProductType  String?  @map("media_product_type")
  reach             Int?
  views             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saved             Int?
  totalInteractions Int?     @map("total_interactions")
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(6)

  @@id([alias, mediaId])
  @@index([alias, postedAt])
  @@map("media_insights")
}
