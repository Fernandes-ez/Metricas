# Backend (no compose: http://backend:3001; em dev local: http://localhost:3001)
BACKEND_URL=http://backend:3001

# Login do painel (um usuário só).
# Hash da senha: node mcp/src/hash-password.js AUTH_PASSWORD_HASH   (cole a linha gerada aqui)
AUTH_PASSWORD_HASH=
# Chave que assina o cookie de sessão (>= 32 bytes aleatórios):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
